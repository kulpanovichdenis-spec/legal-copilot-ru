{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-search-request.schema.json",
  "title": "Provider-neutral legal search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue", "jurisdiction", "data_classification"],
  "properties": {
    "issue": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 2},
    "as_of_date": {"type": ["string", "null"], "format": "date"},
    "act_number": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "act_date": {"type": ["string", "null"], "format": "date"},
    "title_hint": {"type": ["string", "null"], "maxLength": 500},
    "source_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["legislation", "case_law", "authority", "doctrine", "internal"]}
    },
    "need_supporting": {"type": "boolean", "default": true},
    "need_adverse": {"type": "boolean", "default": false},
    "official_verification": {"type": "boolean", "default": false},
    "research_depth": {"enum": ["quick", "standard", "deep"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
    "matter_id": {"type": ["string", "null"]},
    "data_classification": {
      "enum": ["public_or_abstracted", "internal", "confidential", "personal_data"]
    }
  }
}
