{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-object.schema.json",
  "title": "Reusable verified legal knowledge object",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_id", "type", "issue", "position", "provenance", "verification", "status", "created_at", "updated_at"],
  "properties": {
    "knowledge_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["legal_issue", "case_position", "authority_position", "doctrine_point", "practice_pattern"]},
    "pattern_kind": {"enum": ["evidence", "drafting", "procedure", "settlement", "enforcement", "risk_antipattern"]},
    "support_level": {"enum": ["single_case", "multi_case", "court_confirmed"]},
    "source_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reuse_target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(procedural-document-drafter|counterparty-letter|contract-review|contract-drafter|position-critic|legal-opinion|intake_checklist|playbook:[a-z0-9-]+)$"
      }
    },
    "legal_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["norm", "status"],
        "properties": {
          "norm": {"type": "string", "minLength": 3},
          "status": {"enum": ["requires_current_law_check", "verified_current"]}
        }
      }
    },
    "requires_current_law_check": {"type": "boolean"},
    "topic": {"type": ["string", "null"]},
    "issue": {"type": "string", "minLength": 1},
    "position": {"type": "string", "minLength": 1},
    "applies_when": {"type": "array", "items": {"type": "string"}},
    "does_not_apply_when": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_at", "verified_by", "note", "candidate_hash"],
      "properties": {
        "status": {"enum": ["machine_extracted", "machine_reviewed", "human_verified"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_by": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]},
        "candidate_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "valid_as_of": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["active", "possibly_stale", "requires_revalidation", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "superseded_at": {"type": ["string", "null"], "format": "date-time"},
    "superseded_by": {"type": ["string", "null"]},
    "supersession_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "practice_pattern"}}, "required": ["type"]},
      "then": {"required": ["pattern_kind", "support_level", "source_case_ids", "review_questions", "reuse_target", "requires_current_law_check"]}
    }
  ]
}
