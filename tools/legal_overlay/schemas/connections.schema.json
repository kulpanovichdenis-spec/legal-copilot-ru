{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connections.schema.json",
  "title": "Legal Overlay connections",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "version": {"const": 1},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "adapter"],
        "properties": {
          "enabled": {"type": "boolean"},
          "adapter": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "endpoint_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "secret_refs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "priority": {"type": "integer", "minimum": 0},
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "transitional_external_proxy": {"type": "boolean"},
          "options": {"type": "object"}
        }
      }
    }
  }
}
