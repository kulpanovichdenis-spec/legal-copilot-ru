{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/watch/session_start.py\"",
            "timeout": 10,
            "statusMessage": "Проверяю очередь входящих"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/pre_anonymize/project_guard.py\" --runner claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
